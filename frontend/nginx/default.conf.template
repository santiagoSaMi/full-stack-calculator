# Rendered at container start. Two values are substituted, and nothing else:
#   ${BACKEND_URL}            from the BACKEND_URL environment variable
#   ${NGINX_LOCAL_RESOLVERS}  the container's own DNS servers, which the nginx
#                             image reads from /etc/resolv.conf

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;

    # Look the backend's name up as requests arrive (caching it for 10s), not
    # once at start-up. A backend that is recreated with a new address is then
    # picked up without restarting nginx, and nginx can start before it.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # API requests go to the backend with the path unchanged. The browser
    # only ever talks to this server, so the backend needs no CORS setup.
    location /api/ {
        # proxy_pass only resolves at request time when given a variable.
        set $backend_url "${BACKEND_URL}";
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    # Vite puts a content hash in every file name under /assets/, so these
    # can be cached for a long time.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    # The page itself must be revalidated, so a new deployment is picked up.
    location = /index.html {
        expires -1;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
